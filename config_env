# Load local machine overrides if present (git-ignored)
if [ -f "${APP_ROOT}/NOGIT-secrets/config_env.local" ]; then
    source "${APP_ROOT}/NOGIT-secrets/config_env.local"
fi

export APP_READY=1
echo "[+] Environment loaded successfully (Root: ${APP_ROOT})."

# 8. Auto-invoke agy if tag contains "agy"
if [[ "${LOCAL_TAG:-}" == *agy* ]] || [[ "${1:-}" == *agy* ]] || [[ "${2:-}" == *agy* ]]; then
    if command -v agy >/dev/null 2>&1; then
        echo "[*] Tag containing 'agy' detected - launching agy..."
        agy
    else
        echo "[!] 'agy' tag requested, but the 'agy' CLI command was not found in PATH."
    fi
fi
